							<Interval>1HOUR</Interval>
							<Type>PER-AVER</Type>
							<DSS_Path>/USBR/TRINITY_DAM_OUTFLOW/TEMP-WATER//1HOUR/GRAB2PROCESSED/</DSS_Path>
							<DSS_Filename>%%observedDir%%/WTMP_SacTrn_Historical.dss</DSS_Filename>
							<lineColor>#5b9bd5</lineColor>
							<lineWidth>1</lineWidth>
							<lineStylePattern>solid</lineStylePattern>
							<zorder>4</zorder>
							<omitvalue>-901.0</omitvalue>
							<alpha>0.3</alpha>
						</line>
						<line>
							<label>Observed Daily</label>
							<Flag>Observed</Flag>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<DSS_Path>/USBR/TRINITY_DAM_OUTFLOW/TEMP-WATER//1HOUR/GRAB2PROCESSED/</DSS_Path>
							<DSS_Filename>%%observedDir%%/WTMP_SacTrn_Historical.dss</DSS_Filename>
							<lineColor>#5b9bd5</lineColor>
							<lineWidth>1</lineWidth>
							<lineStylePattern>solid</lineStylePattern>
							<zorder>8</zorder>
							<omitvalue>-901.0</omitvalue>
						</line>						
						<Line>
