								<filter>
									<w2_file>qwo_wd1_seg52.csv</w2_file>
									<skiprows>3</skiprows>
									<Interval>1DAY</Interval>
									<Type>PER-AVER</Type>
									<value>0.028316847</value>
									<when>under</when>
								</filter>
							</filters>
							<lineWidth>2</lineWidth>
							<zorder>5</zorder>
						</Line>
						<line>
							<label>%%simulationname%% Daily</label>
							<Flag>Computed</Flag>
							<Parameter>Temperature</Parameter>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<filterbylimits>True</filterbylimits>
							<DSS_Path>//TRINITY DAM/TEMP-WATER TEMPERATURE//1HOUR/%%Fpart%%/</DSS_Path>
							<DSS_Filename>%%ModelDSS%%</DSS_Filename>
							<lineColors>
								<linecolor>red</linecolor>
								<linecolor>green</linecolor>
