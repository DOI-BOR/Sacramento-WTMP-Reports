					<ylabel>Temperature (%%units%%)</ylabel>
					<splitbyyear>true</splitbyyear>
					<includeallyears>true</includeallyears>
					<yearblocks>10</yearblocks>
<!--					<yticks>
						<spacing>2</spacing>
					</yticks>-->
