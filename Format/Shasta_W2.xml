<Chapters>
	<Chapter>
		<Name>Shasta</Name>
		<Region>Shasta</Region>
		<Sections>
			<Section>
				<Header>Shasta Lake Temperatures Near Dam</Header>
				<Object>
					<Type>ProfilePlot</Type>
					<XLabel>Temperature (%%units%%)</XLabel>
					<Description>Shasta Lake w tribs %%year%%</Description>
					<SplitByYear>True</SplitByYear>
					<Parameter>Temperature</Parameter>
					<XLims>
                        <min>0</min>
                        <max>30</max>
                    </XLims>
					<Lines>
						<Line>
							<label>Computed</label>
							<Flag>Computed</Flag>
							<Parameter>Temperature</Parameter>
							<W2_Segment>77</W2_Segment>
							<lineColor>Orange</lineColor>
							<lineWidth>2</lineWidth>
							<zorder>4</zorder>
						</Line>
						<Line>
							<label>Observed</label>
							<Flag>Observed</Flag>
							<Parameter>Temperature</Parameter>
							<lineColor>Blue</lineColor>
							<lineWidth>2</lineWidth>
							<lineStylePattern>solid</lineStylePattern>
							<zorder>4</zorder>
							<FileName>%%observedDir%%/Profile Shasta Lake w tribs temperature.txt</FileName>
						</Line>
					</Lines>
				</Object>
			</Section>
			<Section>
				<Header>Shasta Lake Outflow Temperature</Header>
				<Object>
					<Type>TimeSeriesPlot</Type>
					<Title>%%region%%, Simulation: %%SimulationName%%</Title>
					<Description>Shasta Temperature Outflow</Description>
					<ylabel>Temperature (%%units%%)</ylabel>
					<Lines>
						<Line>
							<label>Modeled</label>
							<Flag>Computed</Flag>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<skiprows>3</skiprows>
							<Parameter>Temperature</Parameter>
							<W2_File>TWO_77.OPT</W2_File>
							<lineColor>Orange</lineColor>
							<lineStylePattern>dash</lineStylePattern>
							<lineWidth>2</lineWidth>
							<zorder>7</zorder>
						</Line>
						<Line>
							<label>Observed</label>
							<Flag>Observed</Flag>
							<Parameter>Temperature</Parameter>
							<DSS_Path>/SHASTA DAM-CORR/FLOW_WT/TEMP_G2//1DAY/TEMPERATURE (F)/</DSS_Path>
							<DSS_Filename>%%observedDir%%/Historic-UpperSac.dss</DSS_Filename>
							<lineColor>Blue</lineColor>
							<lineWidth>2</lineWidth>
							<lineStylePattern>solid</lineStylePattern>
							<zorder>4</zorder>
						</Line>
					</Lines>
				</Object>
				<Object>
					<Type>ErrorStatisticsTable</Type>
					<Description>Shasta Temperature Outflow Error Statistics</Description>
					<Parameter>Temperature</Parameter>
					<SplitByYear>True</SplitByYear>
					<DataPaths>
						<DataPath>
							<Flag>Computed</Flag>
							<Parameter>Temperature</Parameter>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<skiprows>3</skiprows>
							<W2_File>TWO_77.OPT</W2_File>
						</DataPath>
						<DataPath>
							<Flag>Observed</Flag>
							<Parameter>Temperature</Parameter>
							<DSS_Path>/SHASTA DAM-CORR/FLOW_WT/TEMP_G2//1DAY/TEMPERATURE (F)/</DSS_Path>
							<DSS_Filename>%%observedDir%%/Historic-UpperSac.dss</DSS_Filename>
						</DataPath>
					</DataPaths>
				</Object>
				<Object>
					<Type>MonthlyStatisticsTable</Type>
					<Description>Shasta Temperature Outflow Mean Monthly Statistics</Description>
					<Parameter>Temperature</Parameter>
					<SplitByYear>False</SplitByYear>
					<DataPaths>
						<DataPath>
							<Flag>Computed</Flag>
							<Parameter>Temperature</Parameter>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<skiprows>3</skiprows>
							<W2_File>TWO_77.OPT</W2_File>
						</DataPath>
						<DataPath>
							<Flag>Observed</Flag>
							<Parameter>Temperature</Parameter>
							<DSS_Path>/SHASTA DAM-CORR/FLOW_WT/TEMP_G2//1DAY/TEMPERATURE (F)/</DSS_Path>
							<DSS_Filename>%%observedDir%%/Historic-UpperSac.dss</DSS_Filename>
						</DataPath>
					</DataPaths>
				</Object>
			</Section>
			<Section>
				<Header>Shasta Lake Outflow</Header>
				<Object>
					<Type>TimeSeriesPlot</Type>
					<Title>%%region%%, Simulation: %%SimulationName%%</Title>
					<Description>Shasta Outflow</Description>
					<ylabel>Flow (%%units%%)</ylabel>
					<Lines>
						<Line>
							<label>Modeled</label>
							<Flag>Computed</Flag>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<units>cms</units>
							<skiprows>3</skiprows>
							<W2_File>QWO_77.OPT</W2_File>
							<lineColor>Orange</lineColor>
							<lineStylePattern>dash</lineStylePattern>
							<lineWidth>2</lineWidth>
							<zorder>5</zorder>
						</Line>
						<Line>
							<label>Observed</label>
							<Flag>Observed</Flag>
							<Parameter>flow</Parameter>
							<DSS_Path>/SACRAMENTO/SHASTA/FLOW-OUT//1DAY/OBSERVED/</DSS_Path>
							<DSS_Filename>%%observedDir%%/Historic-UpperSac.dss</DSS_Filename>
							<lineColor>Blue</lineColor>
							<lineWidth>2</lineWidth>
							<lineStylePattern>solid</lineStylePattern>
							<zorder>4</zorder>
						</Line>
					</Lines>
				</Object>
				<Object>
					<Type>ErrorStatisticsTable</Type>
					<Description>Shasta Outflow Error Statistics</Description>
					<Parameter>Flow</Parameter>
					<SplitByYear>True</SplitByYear>
					<DataPaths>
						<DataPath>
							<Flag>Computed</Flag>
							<Parameter>flow</Parameter>
							<units>cms</units>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<skiprows>3</skiprows>
							<W2_File>QWO_77.OPT</W2_File>
						</DataPath>
						<DataPath>
							<Flag>Observed</Flag>
							<Parameter>flow</Parameter>
							<DSS_Path>/SACRAMENTO/SHASTA/FLOW-OUT//1DAY/OBSERVED/</DSS_Path>
							<DSS_Filename>%%observedDir%%/Historic-UpperSac.dss</DSS_Filename>
						</DataPath>
					</DataPaths>
				</Object>
				<Object>
					<Type>MonthlyStatisticsTable</Type>
					<Description>Shasta Outflow Mean Monthly Statistics</Description>
					<Parameter>Flow</Parameter>
					<SplitByYear>True</SplitByYear>
					<DataPaths>
						<DataPath>
							<flag>Computed</flag>
							<Type>PER-AVER</Type>
							<Parameter>Flow</Parameter>
							<Interval>1DAY</Interval>
							<units>cms</units>
							<skiprows>3</skiprows>
							<W2_File>QWO_77.OPT</W2_File>
						</DataPath>
						<DataPath>
							<flag>Observed</flag>
							<Parameter>flow</Parameter>
							<DSS_Path>/SACRAMENTO/SHASTA/FLOW-OUT//1DAY/OBSERVED/</DSS_Path>
							<DSS_Filename>%%observedDir%%/Historic-UpperSac.dss</DSS_Filename>
						</DataPath>
					</DataPaths>
				</Object>
			</Section>
