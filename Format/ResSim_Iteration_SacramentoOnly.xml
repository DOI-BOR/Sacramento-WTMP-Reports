<Chapters>
	<Chapter>
		<Name>Iterations</Name>
		<debug>true</debug>
		<memberiteration>true</memberiteration>
		<Sections>
			<Section>
				<header>Outflow Iteration %%member%%</header>
				<Object>
					<type>forecasttable</type>
					<Description>Iteration %%member%% run information</Description>
				</Object>
				<Object>
					<type>timeseriesplot</type>
					<title>Sacramento Modeled Outflow: Iteration %%member%%</title>
					<Description>Sacramento Modeled Outflow %%year%% Iteration %%member%%</Description>
					<ylabel>Flow (%%units%%)</ylabel>
					<unitsystem>english</unitsystem>
					<legend_outside>Right</legend_outside>
					<lines>
						<line>
							<flag>Shasta</flag>
							<label>Shasta</label>
							<DSS_Filename>%%SimulationDir%%\forecastResults.dss</DSS_Filename>
							<DSS_Path>//SHASTA OUT/Flow//1HOUR/*|%%FPART%%/</DSS_Path>
							<interval>1DAY</interval>
							<type>PER-AVER</type>
						</line>
						<line>
							<flag>Keswick</flag>
							<label>Keswick</label>
							<DSS_Filename>%%SimulationDir%%\forecastResults.dss</DSS_Filename>
							<DSS_Path>//Keswick Dam/Flow//1HOUR/*|%%FPART%%/</DSS_Path>
							<interval>1DAY</interval>
							<type>PER-AVER</type>
						</line>
