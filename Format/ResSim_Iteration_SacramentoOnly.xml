							<DSS_Path>//Sacramento R + Clear CR/Flow//1HOUR/*|%%FPART%%/</DSS_Path>
							<interval>1DAY</interval>
							<type>PER-AVER</type>
						</line>
					</lines>
				</Object>
				<Object>
					<type>ErrorStatisticsTable</type>
					<primarykeyheader>Location</primarykeyheader>
					<unitsystem>english</unitsystem>
					<description>Sacramento Modeled Outflow Iteration %%member%% Statistical Summary %%startmonth%% - %%endmonth%% %%year%% (%%units%%)</description>
					<xlims>
						<min></min>
						<max></max>
					</xlims>
					<Datapaths>
						<Datapath>
							<flag>Shasta</flag>
							<DSS_Filename>%%SimulationDir%%\forecastResults.dss</DSS_Filename>
							<DSS_Path>//Shasta out/Flow//1HOUR/*|%%FPART%%/</DSS_Path>
							<interval>1DAY</interval>
						</Datapath>
						<Datapath>
							<flag>Keswick</flag>
							<DSS_Filename>%%SimulationDir%%\forecastResults.dss</DSS_Filename>
							<DSS_Path>//Keswick Dam/Flow//1HOUR/*|%%FPART%%/</DSS_Path>
							<interval>1DAY</interval>
						</Datapath>
						<Datapath>
							<flag>CCR</flag>
							<DSS_Filename>%%SimulationDir%%\forecastResults.dss</DSS_Filename>
							<DSS_Path>//SACRAMENTO R + CLEAR CR/Flow//1HOUR/*|%%FPART%%/</DSS_Path>
							<interval>1DAY</interval>
						</Datapath>
					</Datapaths>
					<rows>
						<row>Shasta|%%maximum.Shasta%%|%%mean.Shasta%%|%%minimum.Shasta%%</row>
						<row>Keswick|%%maximum.Keswick%%|%%mean.Keswick%%|%%minimum.Keswick%%</row>
						<row>CCR|%%maximum.CCR%%|%%mean.CCR%%|%%minimum.CCR%%</row>
					</rows>
					<headers>
						<header>Maximum</header>
						<header>Mean</header>
						<header>Minimum</header>
					</headers>
				</Object>
