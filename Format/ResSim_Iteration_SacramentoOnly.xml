					<type>ErrorStatisticsTable</type>
					<primarykeyheader>Month</primarykeyheader>
					<unitsystem>english</unitsystem>
					<description>Sacramento Modeled Outflow Iteration %%member%% Monthly Average %%year%% (%%units%%)</description>
