							<Type>INST-VAL</Type>
							<DSS_Path>/USBR/KESWICK_TOUT/TEMP-WATER//1HOUR/USBR_BLESSED/</DSS_Path>
							<DSS_Filename>%%observedDir%%/WTMP_SacTrn_Historical.dss</DSS_Filename>
