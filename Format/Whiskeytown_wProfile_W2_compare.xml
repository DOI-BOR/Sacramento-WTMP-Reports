<Chapters>
	<Chapter>
		<Name>Whiskeytown</Name>
		<Region>Whiskeytown</Region>
		<Sections>
			<Section>
				<Header>Whiskeytown Reservoir Temperatures Near Dam</Header>
				<Object>
					<Type>ProfilePlot</Type>
					<Description>Whiskeytown %%year%%</Description>
					<XLabel>Temperature (%%units%%)</XLabel>
					<SplitByYear>True</SplitByYear>
					<Parameter>Temperature</Parameter>
					<profilesperrow>4</profilesperrow>
					<DatesSource>Observed_S1</DatesSource>
					<XLims>
						<min>0</min>
						<max>30</max>
					</XLims>
					<ylims>
						<max>1250</max>
						<min>950</min>
					</ylims>
					<xticks>
						<spacing>5</spacing>
					</xticks>
					<Lines>
						<Line>
							<label>%%SimulationName%%</label>
							<Flag>Computed</Flag>
							<Parameter>Temperature</Parameter>
							<ResSimResName>Whiskeytown Lake</ResSimResName>
							<lineColors>
								<linecolor>red</linecolor>
								<linecolor>green</linecolor>
								<linecolor>orange</linecolor>
							</lineColors>
							<lineStylePattern>dashed</lineStylePattern>
							<lineWidth>2</lineWidth>
							<zorder>4</zorder>
						</Line>
						<Line>
							<label>Observed Site 1</label>
							<Flag>Observed_S1</Flag>
							<Parameter>Temperature</Parameter>
							<lineColor>#5b9bd5</lineColor>
							<lineWidth>2</lineWidth>
							<lineStylePattern>solid</lineStylePattern>
							<zorder>4</zorder>
							<FileName>%%observedDir%%\whiskeytown_1Prof.txt</FileName>
						</Line>
						<Line>
							<label>Observed Site 2</label>
							<Flag>Observed_S2</Flag>
							<Parameter>Temperature</Parameter>
							<lineColor>Green</lineColor>
							<lineWidth>2</lineWidth>
							<lineStylePattern>solid</lineStylePattern>
							<zorder>4</zorder>
							<FileName>%%observedDir%%\whiskeytown_2Prof.txt</FileName>
						</Line>
						<Line>
							<label>Observed Site 3</label>
							<Flag>Observed_S3</Flag>
							<Parameter>Temperature</Parameter>
							<lineColor>Fuchsia</lineColor>
							<lineWidth>2</lineWidth>
							<lineStylePattern>solid</lineStylePattern>
							<zorder>4</zorder>
							<FileName>%%observedDir%%\whiskeytown_3Prof.txt</FileName>
						</Line>
					</Lines>
					<hlines>
						<hline>
							<flag>waterlevel</flag>
							<parameter>elevation</parameter>
							<interval>1HOUR</interval>
							<Type>PER-AVER</Type>
							<DSS_Path>//Whiskeytown Lake-Pool/Elev//1Hour/%%Fpart%%/</DSS_Path>
							<DSS_Filename>%%ModelDSS%%</DSS_Filename>
							<scalar>1</scalar>
							<linecolor>black</linecolor>
						</hline>
					</hlines>
				</Object>
			</Section>

