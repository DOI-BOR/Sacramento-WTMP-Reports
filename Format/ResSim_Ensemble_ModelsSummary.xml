			<Section>
				<header>Shasta</header>
				<Object>
					<type>timeseriesplot</type>
					<title>Shasta Lake Outflow Forecast Runs with Envelopes</title>
					<Description>Shasta Lake Outflow Temperature variable input with percentile envelopes computed</Description>
					<ylabel>Water Temperature (%%units%%)</ylabel>
					<unitsystem>english</unitsystem>
					<legend_outside>True</legend_outside>
					<lines>
						<line>
							<flag>computed</flag>
							<label>Computed</label>
							<DSS_Filename>%%SimulationDir%%\forecastResults.dss</DSS_Filename>
							<DSS_Path>//SHASTA OUT/TEMP-WATER TEMPERATURE//1HOUR/*|%%FPART%%/</DSS_Path>
							<linecolor>darkgreen</linecolor>
							<interval>1DAY</interval>
							<envelopes>
								<envelope>
									<percent>100</percent>
									<label>Maximum</label>
									<linestylepattern>dotted</linestylepattern>
									<linewidth>3</linewidth>
								</envelope>
								<envelope>
									<percent>0</percent>
									<label>Minimum</label>
									<linewidth>3</linewidth>
									<linestylepattern>dotted</linestylepattern>
								</envelope>
								<envelope>
									<percent>25</percent>
									<label>Percentile: 25%</label>
									<linestylepattern>dashed</linestylepattern>
								</envelope>
								<envelope>
									<percent>75</percent>
									<label>Percentile 75%</label>
									<linestylepattern>dashed</linestylepattern>
								</envelope>
								<envelope>
									<percent>50</percent>
									<label>Mean</label>
									<linewidth>3</linewidth>
									<linestylepattern>solid</linestylepattern>
								</envelope>
							</envelopes>
						</line>
					</lines>
				</Object>
