										<linecolor>maroon</linecolor>
										<linecolor>violet</linecolor>
									</linecolors>
									<lineStylePattern>dashed</lineStylePattern>
									<omitvalue>-901.0</omitvalue>
								</line>
							</lines>
							<hlines>
								<hline>
									<label>Spillway Crest</label>
									<value>537</value>
									<linecolor>black</linecolor>
									<linestylepattern>solid</linestylepattern>
								</hline>
								<hline>
									<label>Intake Top</label>
									<value>547.5</value>
									<linecolor>black</linecolor>
									<linestylepattern>dotted</linestylepattern>
								</hline>
							</hlines>
						</ax>
					</axs>
				</Object>
			</Section>
