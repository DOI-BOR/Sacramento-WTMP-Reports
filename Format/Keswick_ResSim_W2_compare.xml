			<Section>
				<Header>Keswick Reservoir Outflow Temperature</Header>
				<Object>
					<Type>TimeSeriesPlot</Type>
					<Title>%%region%%, Simulation Comparison %%year%%</Title>
					<Description>Keswick Reservoir Outflow Temperature %%year%%</Description>
					<ylabel>Temperature (%%units%%)</ylabel>
					<splitbyyear>true</splitbyyear>
					<includeallyears>true</includeallyears>
					<yticks>
						<spacing>2</spacing>
					</yticks>
					<xlabel>Date</xlabel>
					<lines>
						<line>
							<label>Observed</label>
							<Flag>Observed</Flag>
							<Parameter>Temperature</Parameter>
							<Interval>1HOUR</Interval>
							<Type>INST-VAL</Type>
							<DSS_Path>/USBR/KESWICK_TOUT/TEMP-WATER//1HOUR/USBR_BLESSED/</DSS_Path>
							<DSS_Filename>%%observedDir%%/USBR_inputs.dss</DSS_Filename>
							<lineColor>#5b9bd5</lineColor>
							<lineWidth>1</lineWidth>
							<lineStylePattern>solid</lineStylePattern>
							<zorder>4</zorder>
							<alpha>0.3</alpha>
							<omitvalue>-901.0</omitvalue>
						</line>
						<line>
							<label>Observed Daily</label>
							<Flag>Observed</Flag>
							<Parameter>Temperature</Parameter>
							<Interval>1DAY</Interval>
							<Type>INST-VAL</Type>
							<DSS_Path>/USBR/KESWICK_TOUT/TEMP-WATER//1HOUR/USBR_BLESSED/</DSS_Path>
							<DSS_Filename>%%observedDir%%/USBR_inputs.dss</DSS_Filename>
							<lineColor>#5b9bd5</lineColor>
							<lineWidth>1</lineWidth>
							<lineStylePattern>solid</lineStylePattern>
							<zorder>8</zorder>
							<omitvalue>-901.0</omitvalue>
						</line>	
						<Line>
							<label>%%simulationname%%</label>
							<Flag>Computed</Flag>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<skiprows>3</skiprows>
							<units>c</units>
							<W2_File>TWO_102.OPT</W2_File>
							<linecolors>
								<linecolor>darkgreen</linecolor>
								<linecolor>maroon</linecolor>
								<linecolor>violet</linecolor>
							</linecolors>
							<lineWidth>1</lineWidth>
							<lineStylePattern>dashed</lineStylePattern>
							<zorder>9</zorder>
						</Line>
						<line>
							<label>%%simulationname%%</label>
							<Flag>Computed</Flag>
							<Parameter>Temperature</Parameter>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<DSS_Path>//KESWICK RESERVOIR-CONTROLLED OUTLET/TEMP-WATER TEMPERATURE//1HOUR/%%Fpart%%/</DSS_Path>
							<DSS_Filename>%%ModelDSS%%</DSS_Filename>
							<linecolors>
								<linecolor>red</linecolor>
								<linecolor>green</linecolor>
								<linecolor>darkblue</linecolor>
							</linecolors>
							<lineStylePattern>dashed</lineStylePattern>
							<lineWidth>1</lineWidth>
							<zorder>9</zorder>
						</line>
					</lines>
				</Object>
				<Object>
					<Type>ErrorStatisticsTable</Type>
					<Description>%%region%%, Simulation Comparison Error Statistics</Description>
					<Parameter>Temperature</Parameter>
					<includeallyears>true</includeallyears>
					<numberformats>
						<numberformat>
							<min>1</min>
							<decimalplaces>1</decimalplaces>
						</numberformat>
						<numberformat>
							<max>1</max>
							<decimalplaces>2</decimalplaces>
						</numberformat>
					</numberformats>
					<tablecolors>
						<tablecolor>
							<statistic>meanbias</statistic>
							<thresholds>
								<threshold>
									<value>0.75</value>
									<colorwhen>over</colorwhen>
								</threshold>
								<threshold>
									<value>-0.75</value>
									<colorwhen>under</colorwhen>
								</threshold>
							</thresholds>
						</tablecolor>
						<tablecolor>
							<statistic>nse</statistic>
							<thresholds>
								<threshold>
									<value>0.65</value>
									<colorwhen>under</colorwhen>
								</threshold>
							</thresholds>
						</tablecolor>
						<tablecolor>
							<statistic>MAE</statistic>
							<thresholds>
								<threshold>
									<value>1.0</value>
									<colorwhen>over</colorwhen>
								</threshold>
							</thresholds>
						</tablecolor>
						<tablecolor>
							<statistic>RMSE</statistic>
							<thresholds>
								<threshold>
									<value>1.5</value>
									<colorwhen>over</colorwhen>
								</threshold>
							</thresholds>
						</tablecolor>
					</tablecolors>
					<DataPaths>
						<DataPath>
							<Flag>Computed</Flag>
							<Parameter>Temperature</Parameter>
							<Interval>1HOUR</Interval>
							<Type>PER-AVER</Type>
							<skiprows>3</skiprows>
							<units>c</units>
							<W2_File>TWO_102.OPT</W2_File>
						</DataPath>
						<DataPath>
							<Flag>Computed</Flag>
							<Parameter>Temperature</Parameter>
							<Interval>1HOUR</Interval>
							<Type>PER-AVER</Type>
							<DSS_Path>//KESWICK RESERVOIR-CONTROLLED OUTLET/TEMP-WATER TEMPERATURE//1HOUR/%%Fpart%%/</DSS_Path>
							<DSS_Filename>%%ModelDSS%%</DSS_Filename>
						</DataPath>
						<DataPath>
							<Flag>Observed</Flag>
							<Interval>1HOUR</Interval>
							<Type>PER-AVER</Type>
							<DSS_Path>/USBR/KESWICK_TOUT/TEMP-WATER//1HOUR/USBR_BLESSED/</DSS_Path>
							<DSS_Filename>%%observedDir%%/USBR_inputs.dss</DSS_Filename>
							<omitvalue>-901.0</omitvalue>
						</DataPath>
					</DataPaths>
				</Object>
			</Section>
			<Section>
				<Header>Keswick Reservoir Outflow</Header>
				<Object>
					<Type>TimeSeriesPlot</Type>
					<Title>%%region%%, Simulation Comparison %%year%%</Title>
					<Description>Keswick Reservoir Outflow %%year%%</Description>
					<ylabel>Flow (%%units%%)</ylabel>
					<splitbyyear>true</splitbyyear>
