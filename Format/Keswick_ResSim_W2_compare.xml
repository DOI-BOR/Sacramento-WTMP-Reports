										<linecolor>red</linecolor>
										<linecolor>green</linecolor>
										<linecolor>darkblue</linecolor>
									</linecolors>
									<lineStylePattern>dashed</lineStylePattern>
								</line>
								<line>
									<label>%%simulationname%%</label>
									<flag>Computed</flag>
									<DSS_Filename>%%ModelDSS%%</DSS_Filename>
									<interval>1DAY</interval>
									<type>Per-Aver</type>
									<parameter>elevation</parameter>
