					<ylims>
						<min>0</min>
					</ylims>
					<unitsystem>english</unitsystem>
					<xlabel>Date</xlabel>
					<lines>
						<line>
							<label>%%simulationname%%</label>
							<Flag>Computed</Flag>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<DSS_Path>//KESWICK RESERVOIR-CONTROLLED OUTLET/FLOW//1HOUR/%%Fpart%%/</DSS_Path>
							<DSS_Filename>%%ModelDSS%%</DSS_Filename>
							<linecolors>
								<linecolor>red</linecolor>
								<linecolor>green</linecolor>
								<linecolor>darkblue</linecolor>
							</linecolors>
							<lineStylePattern>dashed</lineStylePattern>
							<lineWidth>2</lineWidth>
							<zorder>7</zorder>
						</line>
						<Line>
							<label>%%simulationname%%</label>
							<Flag>Computed</Flag>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<skiprows>3</skiprows>
							<units>cms</units>
							<W2_File>QWO_102.OPT</W2_File>
							<linecolors>
								<linecolor>darkgreen</linecolor>
								<linecolor>maroon</linecolor>
								<linecolor>violet</linecolor>
							</linecolors>
							<lineStylePattern>dashed</lineStylePattern>
							<lineWidth>2</lineWidth>
							<zorder>9</zorder>
						</Line>
						<line>
							<label>Observed</label>
							<Flag>Observed</Flag>
							<Interval>1DAY</Interval>
							<Type>PER-AVER</Type>
							<DSS_Path>/USBR/KESWICK_QOUT_SUM/FLOW//1HOUR/USBR_DERIVED/</DSS_Path>
							<DSS_Filename>%%observedDir%%/USBR_inputs.dss</DSS_Filename>
							<lineColor>#5b9bd5</lineColor>
							<lineWidth>2</lineWidth>
							<lineStylePattern>solid</lineStylePattern>
							<zorder>4</zorder>
						</line>
					</lines>
				</Object>
			</Section>
